<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Townline — Local business rankings</title>
<meta name="description" content="Discover and rank local businesses near you — new and established — and vote up the ones earning your neighborhood's trust.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#17130f; --ink2:#1f1a14; --paper:#f4ede2;
    --ember:#d9932e; --moss:#5e7a63; --line:#332c24; --muted:#a89c8d;
    --r-card:10px; --r-pill:999px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--ink);color:var(--paper);font-family:'Inter',system-ui,-apple-system,sans-serif;line-height:1.55;}
  h1,h2{font-family:'Bricolage Grotesque',system-ui,sans-serif;margin:0;letter-spacing:-.01em;}
  a{color:inherit;} button,select,input{font-family:inherit;}
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px;}
  :focus-visible{outline:2px solid var(--ember);outline-offset:2px;}

  nav{position:sticky;top:0;z-index:50;background:rgba(23,19,15,.88);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px;}
  .brand{font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:1.25rem;}
  .profile input{background:var(--ink2);border:1px solid var(--line);color:var(--paper);padding:8px 14px;border-radius:var(--r-pill);width:130px;font-size:.85rem;}

  .hero{padding:88px 0 64px;}
  .hero .wrap{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:center;}
  .hero h1{font-size:clamp(2.1rem,4.6vw,3.3rem);line-height:1.1;font-weight:700;}
  .hero p{color:var(--muted);max-width:46ch;margin:18px 0 30px;font-size:1.05rem;}
  .cta-row{display:flex;gap:12px;flex-wrap:wrap;}
  .btn{display:inline-flex;align-items:center;padding:13px 24px;border-radius:var(--r-pill);font-weight:600;text-decoration:none;font-size:.92rem;border:none;cursor:pointer;transition:transform .15s ease;}
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{background:var(--ember);color:var(--ink);}
  .btn-ghost{background:transparent;border:1px solid var(--line);color:var(--paper);}

  .stack{position:relative;height:190px;}
  .stack-card{position:absolute;width:225px;background:var(--ink2);border:1px solid var(--line);border-radius:var(--r-card);padding:16px 18px;display:flex;flex-direction:column;gap:6px;box-shadow:0 20px 40px -20px rgba(0,0,0,.6);animation:settle .7s cubic-bezier(.2,.8,.2,1) both;}
  .stack-card .sc-rank{font-size:.72rem;color:var(--muted);}
  .stack-card .sc-name{font-weight:600;font-size:.95rem;}
  .stack-card .sc-vote{color:var(--ember);font-size:.85rem;font-weight:600;}
  .sc1{top:0;left:16px;transform:rotate(-4deg);animation-delay:.05s;}
  .sc2{top:66px;left:64px;transform:rotate(3deg);animation-delay:.2s;}
  @keyframes settle{from{opacity:0;transform:translateY(16px);}to{opacity:1;}}

  .sponsored{padding:26px 0;}
  .sponsored-inner{border:1px solid var(--line);border-radius:var(--r-card);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;background:var(--ink2);}
  .s-label{font-size:.72rem;background:rgba(217,147,46,.14);color:var(--ember);padding:3px 10px;border-radius:var(--r-pill);}
  .sponsored h3{font-size:1rem;margin:8px 0 2px;font-weight:600;}
  .sponsored p{margin:0;color:var(--muted);font-size:.85rem;}

  .rankings{padding:60px 0 100px;}
  .rankings > .wrap > p{color:var(--muted);margin:8px 0 30px;}
  .controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:26px;}
  .tabs{display:inline-flex;border:1px solid var(--line);border-radius:var(--r-pill);padding:4px;}
  .tabs button{background:none;border:none;color:var(--muted);padding:8px 16px;border-radius:var(--r-pill);font-weight:600;font-size:.85rem;cursor:pointer;}
  .tabs button.active{background:var(--ember);color:var(--ink);}
  select,.locate-btn{background:var(--ink2);border:1px solid var(--line);color:var(--paper);padding:8px 14px;border-radius:var(--r-pill);font-size:.85rem;cursor:pointer;}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px;}
  .card{background:var(--ink2);border:1px solid var(--line);border-radius:var(--r-card);padding:20px;display:flex;flex-direction:column;gap:8px;transition:border-color .15s;}
  .card:hover{border-color:var(--ember);}
  .card-top{display:flex;justify-content:space-between;align-items:center;}
  .rank-num{font-size:.75rem;color:var(--muted);}
  .dot-new,.dot-est{font-size:.8rem;display:flex;align-items:center;gap:5px;}
  .dot-new{color:var(--ember);} .dot-est{color:var(--moss);}
  .card h3{font-size:1.1rem;font-weight:600;}
  .card .meta{color:var(--muted);font-size:.85rem;}
  .card .blurb{color:var(--muted);font-size:.88rem;flex:1;}
  .card-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:6px;}
  .upvote{display:flex;gap:6px;align-items:center;background:none;border:1px solid var(--line);color:var(--paper);padding:7px 14px;border-radius:var(--r-pill);cursor:pointer;font-weight:600;font-size:.85rem;}
  .upvote:hover{border-color:var(--ember);}
  .upvote.voted{background:rgba(217,147,46,.15);border-color:var(--ember);color:var(--ember);cursor:default;}

  footer{border-top:1px solid var(--line);padding:32px 0;color:var(--muted);font-size:.85rem;}

  @media(prefers-reduced-motion:reduce){.stack-card{animation:none;opacity:1;}.btn:hover{transform:none;}}
  @media(max-width:820px){.hero .wrap{grid-template-columns:1fr;}.stack{display:none;}}
  @media(max-width:480px){nav .wrap{height:60px;}.profile input{width:96px;}}
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <div class="brand">Townline</div>
    <div class="profile"><input id="profileInput" type="text" placeholder="Your name" maxlength="24" aria-label="Your name"></div>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <div>
      <h1>Find out who's actually earning trust downtown.</h1>
      <p>Vote up the local businesses doing right by your neighborhood — new upstarts and old reliables, ranked side by side.</p>
      <div class="cta-row">
        <a href="#rankings" class="btn btn-primary">See the rankings</a>
        <a href="mailto:hello@example.com?subject=Partnership%20Inquiry" class="btn btn-ghost">Propose a partnership</a>
      </div>
    </div>
    <div class="stack" aria-hidden="true">
      <div class="stack-card sc1"><span class="sc-rank">Rank 2</span><span class="sc-name">Fairview Family Bakery</span><span class="sc-vote">▲ 88</span></div>
      <div class="stack-card sc2"><span class="sc-rank">Rank 1</span><span class="sc-name">Cedar &amp; Co. Bookshop</span><span class="sc-vote">▲ 60</span></div>
    </div>
  </div>
</header>

<section class="sponsored">
  <div class="wrap">
    <div class="sponsored-inner">
      <div>
        <span class="s-label">Sponsored</span>
        <h3>John's B.M.B Tree Service</h3>
        <p>Veteran-owned tree removal, trimming &amp; storm cleanup — Mississippi Gulf Coast.</p>
      </div>
      <a href="https://johnsbmbtreeservice.github.io/.com/" target="_blank" rel="sponsored noopener" class="btn btn-primary" aria-label="Visit John's B.M.B Tree Service website">Visit site</a>
    </div>
  </div>
</section>

<section class="rankings" id="rankings">
  <div class="wrap">
    <h2>Rankings</h2>
    <p>Updated the moment your neighbors vote.</p>
    <div class="controls">
      <div class="tabs">
        <button class="tab-btn active" data-tab="new" type="button">New, under 5 years</button>
        <button class="tab-btn" data-tab="established" type="button">Established</button>
      </div>
      <select id="cityFilter" aria-label="Filter by town"><option value="all">All towns</option></select>
      <button class="locate-btn" id="locateBtn" type="button">Use my location</button>
    </div>
    <div id="grid" class="grid"></div>
  </div>
</section>

<footer>
  <div class="wrap">Starter template — sample listings shown for demonstration. <a href="mailto:hello@example.com?subject=Add%20my%20business">Add your business</a></div>
</footer>

<script>
const businesses = [
  {id:'riverside-roasters', name:'Riverside Roasters', category:'Coffee shop', city:'Riverside', founded:2023, blurb:"Small-batch coffee roasted daily in the heart of downtown.", base:14},
  {id:'brightleaf-landscaping', name:'BrightLeaf Landscaping', category:'Landscaping', city:'Springfield', founded:2011, blurb:"Full-service design and upkeep for homes and offices.", base:52},
  {id:'pixel-pine', name:'Pixel & Pine Web Studio', category:'Web design', city:'Riverside', founded:2024, blurb:"A two-person studio building fast, friendly sites for local shops.", base:9},
  {id:'fairview-bakery', name:'Fairview Family Bakery', category:'Bakery', city:'Fairview', founded:2005, blurb:"Third-generation bakery known for sourdough and birthday cakes.", base:88},
  {id:'summit-auto', name:'Summit Auto Care', category:'Auto repair', city:'Springfield', founded:2022, blurb:"Honest, transparent repairs with free diagnostics on Mondays.", base:21},
  {id:'golden-hour-yoga', name:'Golden Hour Yoga', category:'Wellness', city:'Fairview', founded:2019, blurb:"Sunrise and candlelight classes for every level.", base:37},
  {id:'cedar-books', name:'Cedar & Co. Bookshop', category:'Bookshop', city:'Riverside', founded:2013, blurb:"Independent shop with a reading nook and monthly author nights.", base:60},
  {id:'northgate-electric', name:'Northgate Electric', category:'Electrician', city:'Springfield', founded:2025, blurb:"Licensed electricians for upgrades and EV charger installs.", base:6},
];
const byId = Object.fromEntries(businesses.map(b=>[b.id,b]));
const YEAR = new Date().getFullYear();
const isNew = b => (YEAR - b.founded) < 5;

const profileInput = document.getElementById('profileInput');
profileInput.value = localStorage.getItem('tl_profile') || '';
profileInput.addEventListener('input', () => { localStorage.setItem('tl_profile', profileInput.value.trim()); render(); });

function votesMap(){ try{ return JSON.parse(localStorage.getItem('tl_votes')||'{}'); } catch(e){ return {}; } }
function voteCount(id){
  const m = votesMap(); let c = 0;
  Object.values(m).forEach(arr => { if(arr.includes(id)) c++; });
  return (byId[id].base||0) + c;
}
function hasVoted(id){
  const p = profileInput.value.trim(); if(!p) return false;
  return (votesMap()[p]||[]).includes(id);
}
function castVote(id){
  const p = profileInput.value.trim();
  if(!p){ profileInput.focus(); profileInput.placeholder = 'Add your name first'; return; }
  const m = votesMap(); m[p] = m[p]||[];
  if(!m[p].includes(id)){ m[p].push(id); localStorage.setItem('tl_votes', JSON.stringify(m)); render(); }
}

const cityFilter = document.getElementById('cityFilter');
[...new Set(businesses.map(b=>b.city))].sort().forEach(c=>{
  const o = document.createElement('option'); o.value=c; o.textContent=c; cityFilter.appendChild(o);
});
cityFilter.addEventListener('change', render);

let activeTab = 'new';
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active'); activeTab = btn.dataset.tab; render();
  });
});

document.getElementById('locateBtn').addEventListener('click', ()=>{
  const btn = document.getElementById('locateBtn');
  if(!navigator.geolocation){ btn.textContent = 'Location not supported'; return; }
  btn.textContent = 'Locating…';
  navigator.geolocation.getCurrentPosition(async (pos)=>{
    try{
      const { latitude, longitude } = pos.coords;
      const res = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${latitude}&longitude=${longitude}&localityLanguage=en`);
      const data = await res.json();
      const city = data.city || data.locality || '';
      const match = [...cityFilter.options].find(o => o.value.toLowerCase() === city.toLowerCase());
      if(match){ cityFilter.value = match.value; render(); btn.textContent = 'Near ' + match.value; }
      else{ btn.textContent = 'No listings near ' + (city || 'you') + ' yet'; }
    }catch(e){ btn.textContent = "Couldn't detect your town"; }
  }, ()=>{ btn.textContent = 'Location permission denied'; }, { timeout: 8000 });
});

function render(){
  const grid = document.getElementById('grid');
  const city = cityFilter.value;
  let list = businesses.filter(b => activeTab === 'new' ? isNew(b) : !isNew(b));
  if(city !== 'all') list = list.filter(b => b.city === city);
  list = list.map(b => ({...b, votes: voteCount(b.id)})).sort((a,b)=>b.votes-a.votes);

  grid.innerHTML = list.map((b,i)=>`
    <div class="card">
      <div class="card-top">
        <span class="rank-num">No. ${i+1}</span>
        <span class="${isNew(b)?'dot-new':'dot-est'}">${isNew(b)?'● New':'● Established'}</span>
      </div>
      <h3>${b.name}</h3>
      <div class="meta">${b.category} in ${b.city}, since ${b.founded}</div>
      <div class="blurb">${b.blurb}</div>
      <div class="card-bottom">
        <span class="meta">${b.votes} upvotes</span>
        <button class="upvote ${hasVoted(b.id)?'voted':''}" onclick="castVote('${b.id}')" ${hasVoted(b.id)?'disabled':''} type="button">▲ ${hasVoted(b.id)?'Voted':'Upvote'}</button>
      </div>
    </div>
  `).join('') || '<p class="meta">Nothing matches this filter yet.</p>';
}
render();
</script>
</body>
</html>
